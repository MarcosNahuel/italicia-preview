# Vercel: configure secrets in project italicia. Never commit real values.
# Optional integrations retained from the original site.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key

# Leave checkout disabled until private PDF, provider sandbox and email delivery are verified.
BOOK_PAYMENT_MODE=sandbox
BOOK_DELIVERY_VERIFIED=false
BOOK_CHECKOUT_MP_ENABLED=false
BOOK_CHECKOUT_PAYPAL_ENABLED=false

# Private Blob connection (automatic on Vercel); static token optional for local operations.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
BOOK_PDF_MANUAL_A1=books/manual-a1.pdf
BOOK_PDF_LECTURA_A1=books/lectura-a1.pdf
BOOK_TOKEN_SECRET=
CRON_SECRET=

# Existing merchant developer applications, not the public payment links.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_MERCHANT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=

# Verified sender domain in Resend; reply-to remains italicia.edu@gmail.com.
RESEND_API_KEY=
BOOK_EMAIL_FROM=
